# pixiv 插件配置模板（入库模板；复制为 config.toml 后填真实值）
# Cookie 不放这里：从 .env 的 PIXIV_COOKIE 读取（PHPSESSID=xxx 或整串 cookie 均可）

[auth]
# 允许使用 /novel 与 /pixiv 命令的 QQ 白名单；留空列表 = 所有人可用（不推荐，涉及内容管控）
allow_qq_list = ["你的QQ号"]

[features]
# 每用户命令冷却（秒）
cooldown_seconds = 5
# Pixiv AJAX 请求超时（秒）
api_timeout = 30
# 标签搜图的质量层（收藏分层 tag，免 Premium 的人気順替代）：
# 1000users入り = 只从千收以上作品池挑；冷门标签会自动逐级放宽到 500/100/不限
quality_tier = "1000users入り"
# 随机发图的收藏数门槛（质量兜底：低于该收藏数的图不发，0=不卡）
min_bookmarks = 300
# 抓取系列时最多下载的章节数
max_chapters_per_series = 50
# txt 文件保存目录（相对项目根目录，自动创建）
save_dir = "data/pixiv_novel"

[network]
# HTTP 代理（如 http://127.0.0.1:7890），留空不使用代理
proxy = ""
